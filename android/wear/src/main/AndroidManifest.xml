<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.watch" />
    <!-- "Entrar com o celular": keep the watch's Wi-Fi up and listen on it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <application android:label="Ultratube" android:icon="@drawable/ic_ultratube" android:theme="@style/Ultratube" android:allowBackup="false" android:usesCleartextTraffic="false">
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <!-- Horizontal pages own left/right swipes; back comes from the button or the in-app gesture. -->
        <activity android:name=".PlayerActivity" android:exported="false" android:theme="@style/Ultratube.Player"
            android:launchMode="singleTop" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation" />
    </application>
</manifest>
